{
    "name":"brainite/fileconverter",
    "type":"library",
    "description":"Standardized file converter library.",
    "keywords":[
        "converter"
    ],
    "homepage":"http://www.brainite.org/php-file-converters/",
    "license":"MIT",
    "authors":[
        {
            "name":"Greg Payne",
            "email":"greg.payne@gmail.com"
        }
    ],
    "require":{
        "php":">=8.3",
        "symfony/console":"*",
        "brainite/htmlawed":"dev-master",
        "brainite/quipxml":"^0.4 || ^1.0",
        "brainite/splash":"dev-master"
    },
    "require-dev":{
        "phpunit/phpunit":"^9.6 || ^10"
    },
    "suggest":{
        "mpdf/mpdf":"Enables the Mpdf html->pdf engine (^8.2).",
        "ensepar/html2pdf":"dev-master",
        "zendframework/zend-mail":"Allow for parsing email files."
    },
    "autoload":{
        "psr-4":{
            "FileConverter\\": "src/"
        }
    },
    "minimum-stability": "dev"
}
